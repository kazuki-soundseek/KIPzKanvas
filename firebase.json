{
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "database.rules.json",
      ".firebaserc",
      ".firebaserc.example",
      ".gitignore",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "README.md",
      "CLAUDE.md",
      "AGENTS.md",
      "dev-server.js",
      "*.log",
      "**/desktop.ini",
      "**/Thumbs.db"
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
